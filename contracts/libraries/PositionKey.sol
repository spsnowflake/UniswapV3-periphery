pragma solidity >=0.5.0;

library PositionKey {
    /// （翻译）开发说明：返回 core 库里该头寸的键
    function compute(
        address owner,
        int24 tickLower,
        int24 tickUpper
    ) internal pure returns (bytes32) {
        return keccak256(abi.encodePacked(owner, tickLower, tickUpper));
    }
}
